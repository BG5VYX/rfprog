<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_screen"
    android:maxHeight="560dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="工具"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF00D4FF"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvToolsMachine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KT-10R"
        android:textSize="11sp"
        android:textColor="#FF7A93B8"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />

    <!-- 频率表 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="频率表"
        android:textSize="11sp"
        android:textColor="#FF7A93B8"
        android:letterSpacing="0.1"
        android:paddingTop="6dp"
        android:paddingBottom="4dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnCsvImport"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="导入 CSV"
            android:textSize="13sp"
            android:textColor="#FF00D4FF"
            android:background="@drawable/btn_ghost"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnCsvExport"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="导出 CSV"
            android:textSize="13sp"
            android:textColor="#FF00D4FF"
            android:background="@drawable/btn_ghost"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- 备份 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="备份"
        android:textSize="11sp"
        android:textColor="#FF7A93B8"
        android:letterSpacing="0.1"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBackupEeprom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="备份 EEPROM"
            android:textSize="13sp"
            android:textColor="#FF8FD8FF"
            android:background="@drawable/btn_ghost"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnBackupCal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="备份校准数据"
            android:textSize="13sp"
            android:textColor="#FF00E676"
            android:background="@drawable/btn_ghost"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- 还原 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="还原"
        android:textSize="11sp"
        android:textColor="#FF7A93B8"
        android:letterSpacing="0.1"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnRestoreEeprom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="还原 EEPROM"
            android:textSize="13sp"
            android:textColor="#FFFF8A80"
            android:background="@drawable/btn_ghost"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnRestoreCal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="还原校准数据"
            android:textSize="13sp"
            android:textColor="#FFFFB300"
            android:background="@drawable/btn_ghost"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- 其他 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="镜像 / 高级"
        android:textSize="11sp"
        android:textColor="#FF7A93B8"
        android:letterSpacing="0.1"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnSaveImg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="保存镜像"
            android:textSize="12sp"
            android:textColor="#FFB0BEC5"
            android:background="@drawable/btn_ghost"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnOpenImg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="打开镜像"
            android:textSize="12sp"
            android:textColor="#FFB0BEC5"
            android:background="@drawable/btn_ghost"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />
        <Button
            android:id="@+id/btnHexData"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="原始数据"
            android:textSize="12sp"
            android:textColor="#FFB0BEC5"
            android:background="@drawable/btn_ghost"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseTools"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="关闭"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/btn_primary"
        android:layout_marginTop="16dp" />
</LinearLayout>
</ScrollView>
