<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvHexTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="原始数据"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF00D4FF"
        android:letterSpacing="0.08" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">
        <EditText
            android:id="@+id/etGoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="跳转地址 (HEX)"
            android:textColorHint="#FF3D5A7A"
            android:textColor="#FFE6F1FF"
            android:inputType="text"
            android:textSize="13sp"
            android:fontFamily="monospace" />
        <Button
            android:id="@+id/btnGoto"
            android:layout_width="80dp"
            android:layout_height="42dp"
            android:text="跳转"
            android:textSize="13sp"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/btn_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_log"
        android:layout_marginTop="8dp"
        android:scrollbars="none">
        <TextView
            android:id="@+id/tvHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="#FF8FD8FF"
            android:padding="10dp" />
    </ScrollView>
</LinearLayout>
