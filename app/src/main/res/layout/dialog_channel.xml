<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="频道编辑"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/headerBg" />

    <TextView
        android:id="@+id/tvAddr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="频道 1"
        android:textSize="12sp"
        android:textColor="@color/textLight"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="RX 频率"
            android:textSize="13sp"
            android:gravity="center_vertical" />
        <EditText
            android:id="@+id/etRx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="435.12500"
            android:textSize="15sp"
            android:fontFamily="monospace" />
        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:text="TX 频率"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp" />
        <EditText
            android:id="@+id/etTx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="435.12500"
            android:textSize="15sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="RX 亚音"
            android:textSize="13sp"
            android:gravity="center_vertical" />
        <Spinner
            android:id="@+id/spQt1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="TX 亚音"
            android:textSize="13sp"
            android:gravity="center_vertical" />
        <Spinner
            android:id="@+id/spQt2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="频宽"
            android:textSize="13sp"
            android:gravity="center_vertical" />
        <Spinner
            android:id="@+id/spBand"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp" />
        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:text="功率"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:layout_marginStart="6dp" />
        <Spinner
            android:id="@+id/spPower"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp" />
    </LinearLayout>

    <!-- UV-K5 专属 -->
    <LinearLayout
        android:id="@+id/panelK5Only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panelBg"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UV-K5 专属参数"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/headerBg" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">
            <TextView
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:text="调制"
                android:textSize="13sp"
                android:gravity="center_vertical" />
            <Spinner
                android:id="@+id/spMod"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="38dp" />
        </LinearLayout>
        <CheckBox
            android:id="@+id/cbScramble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扰频 (Scramble)"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="信道名（UV-K5 最多10字符）"
        android:textSize="12sp"
        android:textColor="@color/textLight"
        android:paddingTop="6dp" />
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:maxLength="10"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="32 字节原始数据 (HEX)"
        android:textSize="12sp"
        android:textColor="@color/textDark"
        android:paddingTop="6dp" />
    <EditText
        android:id="@+id/etHex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">
        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="取消"
            android:background="@color/btnGray"
            android:textColor="#FFFFFFFF"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/btnDialogOk"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="保存"
            android:textStyle="bold"
            android:background="@color/btnBlue"
            android:textColor="#FFFFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
